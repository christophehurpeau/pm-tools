{
  "name": "pm-tools-monorepo",
  "private": true,
  "description": "Find out why a dependency is duplicated in a lockfile, and dedupe it.",
  "homepage": "https://github.com/christophehurpeau/pm-tools",
  "bugs": {
    "url": "https://github.com/christophehurpeau/pm-tools/issues"
  },
  "license": "MIT",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": "https://github.com/christophehurpeau/pm-tools.git",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run build:definitions",
    "build:definitions": "tsrs -b",
    "clean": "rm -rf packages/*/dist packages/*/node_modules/.cache/tsc",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "lint": "bun run format && bun run lint:oxlint && bun run lint:eslint",
    "lint:eslint": "eslint --quiet .",
    "lint:oxlint": "oxlint --quiet",
    "prepare": "pob-root-postinstall",
    "test": "TZ=UTC bun test",
    "test:coverage": "TZ=UTC bun test --coverage ",
    "test:coverage:generate": "TZ=UTC bun test --coverage --coverage-report=json",
    "test:watch": "TZ=UTC bun test --watch",
    "tsc": "tsrs -b",
    "tsc:go": "tsc -b"
  },
  "devDependencies": {
    "@pob/eslint-config": "68.3.0",
    "@pob/root": "28.6.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "commitlint": {
    "extends": [
      "@pob/root/commitlint-config"
    ]
  },
  "engines": {
    "node": "^22.18.0 || >=24.14.1"
  }
}
