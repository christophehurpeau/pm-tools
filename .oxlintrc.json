{
  "extends": [
    "./node_modules/@pob/eslint-config/oxlint/base.json",
    "./node_modules/@pob/eslint-config/oxlint/module.json",
    "./node_modules/@pob/eslint-config/oxlint/node.json",
    "./node_modules/@pob/eslint-config/oxlint/typescript.json"
  ],
  "ignorePatterns": [
    ".yarn",
    "**/dist/",
    "**/build/",
    "**/coverage/",
    "**/.next/",
    "**/.tamagui/",
    "**/.expo/",
    "**/*.d.ts",
    "/rollup.config.mjs"
  ],
  "rules": {
    "node-js/no-unsupported-features/node-builtins": [
      "error",
      {
        "ignores": [
          "localStorage",
          "sessionStorage",
          "Storage",
          "util.styleText"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "node-js/no-unsupported-features/node-builtins": [
          "error",
          {
            "ignores": [
              "localStorage",
              "sessionStorage",
              "Storage",
              "util.styleText",
              "assert/strict.partialDeepStrictEqual"
            ]
          }
        ],
        "typescript/no-floating-promises": [
          "error",
          {
            "allowForKnownSafeCalls": [
              {
                "from": "package",
                "name": ["it", "describe", "test", "skip"],
                "package": "node:test"
              }
            ]
          }
        ]
      }
    }
  ]
}
