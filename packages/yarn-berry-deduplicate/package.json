{
  "name": "yarn-berry-deduplicate",
  "version": "7.0.0",
  "description": "List duplicates and dedupe yarn berry lock file",
  "keywords": [
    "dedupe",
    "deduplicate",
    "duplicated",
    "lockfile",
    "package manager",
    "yarn",
    "yarn.lock"
  ],
  "homepage": "https://github.com/christophehurpeau/pm-tools",
  "bugs": {
    "url": "https://github.com/christophehurpeau/pm-tools/issues"
  },
  "license": "MIT",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/pm-tools.git",
    "directory": "packages/yarn-berry-deduplicate"
  },
  "bin": {
    "yarn-berry-deduplicate": "./src/bin/yarn-berry-deduplicate.ts",
    "yarn-berry-why-duplicate": "./src/bin/yarn-berry-why-duplicate.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/definitions/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/definitions/index.d.ts",
      "node": {
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "bun run lint:eslint",
    "lint:eslint": "bun run --cwd '../..' eslint --quiet 'packages/yarn-berry-deduplicate'",
    "test": "bun run --cwd '../..' test -- 'packages/yarn-berry-deduplicate'",
    "tsc": "tsc"
  },
  "dependencies": {
    "@yarnpkg/parsers": "3.1.0",
    "pm-utils": "workspace:*",
    "semver": "7.8.5",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/semver": "7.8.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pob": {
    "bundler": "tsc",
    "entries": [
      "index"
    ]
  }
}
