{
  "name": "yarn-why-duplicate",
  "version": "2.2.1",
  "description": "Simple bin to know why a package is duplicated",
  "keywords": [
    "berry",
    "yarn"
  ],
  "homepage": "https://github.com/christophehurpeau/pm-tools",
  "bugs": {
    "url": "https://github.com/christophehurpeau/pm-tools/issues"
  },
  "license": "MIT",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/pm-tools.git",
    "directory": "packages/yarn-why-duplicate"
  },
  "bin": "./bin/yarn-why-duplicate.mjs",
  "files": [
    "lib",
    "bin"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "bun run lint:oxlint && bun run lint:eslint",
    "lint:eslint": "bun run --cwd '../..' eslint --quiet 'packages/yarn-why-duplicate'",
    "lint:oxlint": "bun run --cwd '../..' oxlint --quiet 'packages/yarn-why-duplicate'",
    "test": "bun run --cwd '../..' test -- 'packages/yarn-why-duplicate'"
  },
  "dependencies": {
    "@yarnpkg/core": "4.9.2",
    "semver": "7.8.5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pob": {}
}
