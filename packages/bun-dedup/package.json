{
  "name": "bun-dedup",
  "version": "2.2.0",
  "description": "List duplicates and dedupe bun lock file",
  "keywords": [
    "bun",
    "dedupe",
    "duplicate"
  ],
  "homepage": "https://github.com/christophehurpeau/pm-tools",
  "bugs": {
    "url": "https://github.com/christophehurpeau/pm-tools/issues"
  },
  "license": "MIT",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/pm-tools.git",
    "directory": "packages/bun-dedup"
  },
  "bin": {
    "bun-dedup": "./dist/bin/bun-dedupe.js",
    "bun-dedupe": "./dist/bin/bun-dedupe.js",
    "bun-why-duplicate": "./dist/bin/bun-why-duplicate.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/definitions/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/definitions/index.d.ts",
      "node": {
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "bun run lint:oxlint && bun run lint:eslint",
    "lint:eslint": "bun run --cwd '../..' eslint --quiet 'packages/bun-dedup'",
    "lint:oxlint": "bun run --cwd '../..' oxlint --quiet 'packages/bun-dedup'",
    "test": "bun run --cwd '../..' test -- 'packages/bun-dedup'",
    "tsc": "tsc"
  },
  "dependencies": {
    "@types/bun": "1.4.2",
    "json5": "2.2.3",
    "pm-dedup-core": "workspace:*",
    "semver": "7.8.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pob": {
    "bundler": "tsc",
    "entries": [
      "index"
    ]
  }
}
