{
  "name": "pnpm-dedup",
  "version": "3.0.0",
  "description": "List duplicates and dedupe pnpm lock file",
  "keywords": [
    "dedupe",
    "duplicate",
    "pnpm"
  ],
  "homepage": "https://github.com/christophehurpeau/pm-tools",
  "bugs": {
    "url": "https://github.com/christophehurpeau/pm-tools/issues"
  },
  "license": "MIT",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/pm-tools.git",
    "directory": "packages/pnpm-dedup"
  },
  "bin": {
    "pnpm-dedup": "./dist/bin/pnpm-dedupe.js",
    "pnpm-dedupe": "./dist/bin/pnpm-dedupe.js",
    "pnpm-why-duplicate": "./dist/bin/pnpm-why-duplicate.js"
  },
  "files": [
    "src",
    "dist",
    "bin"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/definitions/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/definitions/index.d.ts",
      "node": {
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsrs",
    "lint": "bun run lint:oxlint && bun run lint:eslint",
    "lint:eslint": "bun run --cwd '../..' eslint --quiet 'packages/pnpm-dedup'",
    "lint:oxlint": "bun run --cwd '../..' oxlint --quiet 'packages/pnpm-dedup'",
    "test": "bun run --cwd '../..' test -- 'packages/pnpm-dedup'",
    "tsc": "tsrs",
    "tsc:go": "tsc"
  },
  "dependencies": {
    "ci-info": "4.4.0",
    "pm-dedup-core": "workspace:*",
    "semver": "7.8.5",
    "tslib": "^2.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.14.1"
  },
  "pob": {
    "bundler": "tsc",
    "entries": [
      "index"
    ]
  }
}
