{
  "name": "pm-dedup-core",
  "version": "3.0.0",
  "description": "package manager utils",
  "keywords": [],
  "homepage": "https://github.com/christophehurpeau/pm-tools",
  "bugs": {
    "url": "https://github.com/christophehurpeau/pm-tools/issues"
  },
  "license": "MIT",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/pm-tools.git",
    "directory": "packages/pm-dedup-core"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/definitions/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/definitions/index.d.ts",
      "node": {
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsrs",
    "lint": "bun run lint:oxlint && bun run lint:eslint",
    "lint:eslint": "bun run --cwd '../..' eslint --quiet 'packages/pm-dedup-core'",
    "lint:oxlint": "bun run --cwd '../..' oxlint --quiet 'packages/pm-dedup-core'",
    "test": "bun run --cwd '../..' test -- 'packages/pm-dedup-core'",
    "tsc": "tsrs",
    "tsc:go": "tsc"
  },
  "dependencies": {
    "picomatch": "4.0.7",
    "semver": "7.8.6",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/picomatch": "4.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.13.0"
  },
  "pob": {
    "bundler": "tsc",
    "entries": [
      "index"
    ],
    "envs": [
      {
        "target": "node",
        "version": "22"
      }
    ]
  }
}
