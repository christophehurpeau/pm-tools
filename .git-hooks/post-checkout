#!/usr/bin/env sh
[ "$POB_GIT_HOOKS" = "2" ] && set -x
[ "$POB_GIT_HOOKS" = "0" ] && exit 0
[ "$HUSKY" = "0" ] && exit 0

if [ "$1" = "0000000000000000000000000000000000000000" ]; then
  if [ -x scripts/setup-worktree.sh ]; then
    ./scripts/setup-worktree.sh || true
  else
    bun i --frozen-lockfile || true
  fi
  exit 0
fi

if [ -n "$(git diff HEAD@{1}..HEAD@{0} -- bun.lock)" ]; then
  bun i --frozen-lockfile || true
fi
